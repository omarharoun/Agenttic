{
  "name": "agenttic-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run lint:tokens && tsc --noEmit && vite-react-ssg build && node scripts/check-bundle.mjs",
    "build:spa": "tsc --noEmit && vite build",
    "test": "vitest run",
    "verify": "npm run lint && tsc --noEmit && vitest run",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:tokens": "node scripts/check-tokens.mjs",
  "lint:gate": "eslint \"src/pages/**/*.{ts,tsx}\" \"src/components/**/*.{ts,tsx}\"",
    "preview": "vite preview",
    "budget": "node scripts/bundle-budget.mjs",
    "e2e": "playwright test",
    "e2e:update": "playwright test --update-snapshots"
  },
  "dependencies": {
    "@xyflow/react": "^12.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "9.1.0",
    "react-router-dom": "^6.26.0",
    "remark-gfm": "4.0.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.39.5",
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@fontsource/marcellus": "^5.2.8",
    "@playwright/test": "^1.61.1",
    "@types/jest-axe": "^3.5.9",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jest-axe": "^10.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.64.0",
    "vite": "^5.4.0",
    "vite-react-ssg": "^0.9.1",
    "vitest": "^2.1.0"
  }
}
