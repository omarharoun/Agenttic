{
  "name": "agenttic-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run lint:tokens && tsc --noEmit && vite-react-ssg build && node scripts/check-bundle.mjs",
    "build:spa": "tsc --noEmit && vite build",
    "test": "vitest run",
    "verify": "tsc --noEmit && eslint . && vitest run && playwright test",
    "e2e": "playwright test",
    "e2e:update": "playwright test --update-snapshots",
    "preview": "vite preview",
    "lint:tokens": "node scripts/check-tokens.mjs",
    "lint:bundle": "node scripts/check-bundle.mjs"
  },
  "dependencies": {
    "@xyflow/react": "^12.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "9.1.0",
    "react-router-dom": "^6.26.0",
    "remark-gfm": "4.0.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@fontsource/marcellus": "^5.2.8",
    "@playwright/test": "^1.62.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.8.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.65.0",
    "vite": "^5.4.0",
    "vite-react-ssg": "^0.9.1",
    "vitest": "^2.1.0"
  }
}
