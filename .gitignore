# carried ~4.7 MB of binary churn per run.
*.db
*.db-shm
*.db-wal
ascore.db-shm
ascore.db-wal
ascore.*.db
ascore.*.db-shm
ascore.*.db-wal
# seeded/runtime review + calibration stores (config-configurable dirs)
calibration/
review/
report.md
# build artifacts (scripts/release/pypi.sh writes here)
dist/
build/
*.egg-info/
# secrets & host-generated deploy artifacts — never commit
.env
docker-compose.override.yml
backups/
# graphify: generated code graph (~26MB, rebuild with `graphify update .`)
graphify-out/

# playwright (runner may emit at repo root)
test-results/
playwright-report/

# generated run output — `paths.review_dir`. These are PROPOSED regression cases
# written by `agenttic cdv`; promotion is a human decision (HR63) and the
# proposals themselves are per-run artifacts, not source.
review/
